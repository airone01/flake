From: airone01 <airone01@proton.me>
Date: Sun, 8 Nov 2026 18:12:10 +0100
Subject: [PATCH] maven: build offline

---
 project.properties | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/project.properties b/project.properties
index 2c6f1aa..a6e4ad4 100644
--- a/project.properties
+++ b/project.properties
@@ -21,7 +21,7 @@
 
 # TODO: remove http://people.apache.org/repo/m1-snapshot-repository/, just there for SNAPSHOTs
 #maven.repo.remote = http://people.apache.org/repo/m1-snapshot-repository/,http://repo1.maven.org/maven
-maven.repo.remote = http://repo1.maven.org/maven
+maven.repo.local=@repository@
 
 # Repository to deploy to
 maven.repo.list=apache.snapshots
@@ -225,7 +225,7 @@ maven.bootstrap.dir = ${basedir}/bootstrap
 # Offline mode:
 # maven.bootstrap.online = -o
 # ------------------------------------------------------------------------------
-maven.bootstrap.online=
+maven.bootstrap.online= -o
 
 # ------------------------------------------------------------------------------
 # The bootstrap classes consist of an Ant task front that:
