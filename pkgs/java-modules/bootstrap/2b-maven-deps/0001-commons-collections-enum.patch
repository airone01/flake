From 24a30020ebb46ec864048118227fefd80862d450 Mon Sep 17 00:00:00 2001
From: airone01 <airone01@proton.me>
Date: Mon, 9 Nov 2026 01:07:51 +0100
Subject: [PATCH 1/2] commons-collections: enum

---
 org/apache/commons/collections/CollectionUtils.java       | 8 ++++----
 org/apache/commons/collections/EnumerationIterator.java   | 6 +++---
 .../collections/iterators/EnumerationIterator.java        | 6 +++---
 3 files changed, 10 insertions(+), 10 deletions(-)

diff --git a/org/apache/commons/collections/CollectionUtils.java b/org/apache/commons/collections/CollectionUtils.java
index 459c377..e74eade 100644
--- a/org/apache/commons/collections/CollectionUtils.java
+++ b/org/apache/commons/collections/CollectionUtils.java
@@ -636,13 +636,13 @@ public class CollectionUtils {
             return ((Object[])obj)[idx];
         } 
         else if(obj instanceof Enumeration) {
-            Enumeration enum = (Enumeration)obj;
-            while(enum.hasMoreElements()) {
+            Enumeration enumeration = (Enumeration)obj;
+            while(enumeration.hasMoreElements()) {
                 idx--;
                 if(idx == -1) {
-                    return enum.nextElement();
+                    return enumeration.nextElement();
                 } else {
-                    enum.nextElement();
+                    enumeration.nextElement();
                 }
             }
         } 
diff --git a/org/apache/commons/collections/EnumerationIterator.java b/org/apache/commons/collections/EnumerationIterator.java
index c00e0a8..1b09ba1 100644
--- a/org/apache/commons/collections/EnumerationIterator.java
+++ b/org/apache/commons/collections/EnumerationIterator.java
@@ -96,11 +96,11 @@ extends org.apache.commons.collections.iterators.EnumerationIterator {
      *  Constructs a new <Code>EnumerationIterator</Code> that will remove
      *  elements from the specified collection.
      *
-     *  @param enum  the enumeration to use
+     *  @param enumeration  the enumeration to use
      *  @param collection  the collection to remove elements form
      */
-    public EnumerationIterator( Enumeration enum, Collection collection ) {
-        super(enum, collection);
+    public EnumerationIterator( Enumeration enumeration, Collection collection ) {
+        super(enumeration, collection);
     }
 
 }
diff --git a/org/apache/commons/collections/iterators/EnumerationIterator.java b/org/apache/commons/collections/iterators/EnumerationIterator.java
index b99e2a6..c3b0e73 100644
--- a/org/apache/commons/collections/iterators/EnumerationIterator.java
+++ b/org/apache/commons/collections/iterators/EnumerationIterator.java
@@ -101,11 +101,11 @@ public class EnumerationIterator implements Iterator {
      *  Constructs a new <Code>EnumerationIterator</Code> that will remove
      *  elements from the specified collection.
      *
-     *  @param enum  the enumeration to use
+     *  @param enumeration  the enumeration to use
      *  @param collection  the collection to remove elements form
      */
-    public EnumerationIterator( Enumeration enum, Collection collection ) {
-        this.enumeration = enum;
+    public EnumerationIterator( Enumeration enumeration, Collection collection ) {
+        this.enumeration = enumeration;
         this.collection = collection;
         this.last = null;
     }
-- 
