From: airone01 <airone01@proton.me>
Date: Sun, 8 Nov 2026 22:57:01 +0100
Subject: [PATCH 1/3] commons-jexl: enum

---
 src/java/org/apache/commons/jexl/parser/Parser.java  |  4 ++--
 .../commons/jexl/util/EnumerationIterator.java       | 12 ++++++------
 2 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/src/java/org/apache/commons/jexl/parser/Parser.java b/src/java/org/apache/commons/jexl/parser/Parser.java
index 89f9828..6bed2e4 100644
--- a/src/java/org/apache/commons/jexl/parser/Parser.java
+++ b/src/java/org/apache/commons/jexl/parser/Parser.java
@@ -3217,8 +3217,8 @@ public class Parser/*@bgen(jjtree)*/implements ParserTreeConstants, ParserConsta
         jj_expentry[i] = jj_lasttokens[i];
       }
       boolean exists = false;
-      for (java.util.Enumeration enum = jj_expentries.elements(); enum.hasMoreElements();) {
-        int[] oldentry = (int[])(enum.nextElement());
+      for (java.util.Enumeration enumeration = jj_expentries.elements(); enumeration.hasMoreElements();) {
+        int[] oldentry = (int[])(enumeration.nextElement());
         if (oldentry.length == jj_expentry.length) {
           exists = true;
           for (int i = 0; i < jj_expentry.length; i++) {
diff --git a/src/java/org/apache/commons/jexl/util/EnumerationIterator.java b/src/java/org/apache/commons/jexl/util/EnumerationIterator.java
index 57a6c66..dfb7fe4 100644
--- a/src/java/org/apache/commons/jexl/util/EnumerationIterator.java
+++ b/src/java/org/apache/commons/jexl/util/EnumerationIterator.java
@@ -31,17 +31,17 @@ public class EnumerationIterator implements Iterator
     /**
      * The enumeration to iterate.
      */
-    private Enumeration enum = null;
+    private Enumeration enumeration = null;
 
     /**
      * Creates a new iteratorwrapper instance for the specified 
      * Enumeration.
      *
-     * @param enum  The Enumeration to wrap.
+     * @param enumeration  The Enumeration to wrap.
      */
-    public EnumerationIterator( Enumeration enum)
+    public EnumerationIterator( Enumeration enumeration)
     {
-        this.enum = enum;
+        this.enumeration = enumeration;
     }
 
     /**
@@ -51,7 +51,7 @@ public class EnumerationIterator implements Iterator
      */
     public Object next()
     {
-        return enum.nextElement();
+        return enumeration.nextElement();
     }
     
     /**
@@ -61,7 +61,7 @@ public class EnumerationIterator implements Iterator
      */
     public boolean hasNext()
     {
-        return enum.hasMoreElements();
+        return enumeration.hasMoreElements();
     }
 
     /**
